{
  "name": "@pigclaude/desktop",
  "version": "0.0.1",
  "description": "pigclaude 桌面应用",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "e2e:phase1": "pnpm build",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "visual:baseline": "playwright test --update-snapshots",
    "visual:check": "playwright test",
    "package:mac": "pnpm build && electron-builder --config electron-builder.json --mac dmg zip --arm64 --publish never"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@pigclaude/contracts": "workspace:*",
    "@pigclaude/daemon": "workspace:*",
    "@pigclaude/local-store": "workspace:*",
    "@pigclaude/login-gate": "workspace:*",
    "@pigclaude/client-runtime": "workspace:*",
    "@pigclaude/ui-contracts": "workspace:*",
    "@pigclaude/ui-chat": "workspace:*",
    "@pigclaude/ui-composer": "workspace:*",
    "@pigclaude/ui-plugin-manager": "workspace:*",
    "@pigclaude/ui-primitives": "workspace:*",
    "@pigclaude/ui-settings": "workspace:*",
    "@pigclaude/ui-shell": "workspace:*",
    "@pigclaude/ui-workbench": "workspace:*",
    "@pigclaude/proxy-connection": "workspace:*",
    "@pigclaude/session-env": "workspace:*",
    "@pigclaude/switcher": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "electron-updater": "6.8.11",
    "js-yaml": "4.3.2",
    "json5": "2.2.3",
    "lucide-react": "1.0.1",
    "node-pty": "1.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "semver": "7.8.5",
    "tailwind-merge": "3.4.0",
    "tar": "7.5.22",
    "undici": "6.21.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@playwright/test": "1.64.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "5.1.0",
    "electron": "43.8.12",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "author": "PigClaude",
  "productName": "PigClaude",
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.310",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.310",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "0.3.310",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "0.3.310",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "0.3.310",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "0.3.310",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "0.3.310",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.310"
  }
