{
  "name": "pigclaude-frontend",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "test": "node --test tests/turnstile-launcher.node.mjs && pnpm -r --if-present test",
    "e2e:phase1": "playwright test tests/phase1-web-desktop.spec.ts",
    "phase1:launch": "node scripts/phase1-local-launcher.mjs",
    "layout": "node scripts/assert-layout.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "dev:desktop": "pnpm --filter @pigclaude/desktop dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
