{
  "name": "pigclaude-frontend",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "test": "node --test tests/fake-epay-gateway.node.mjs tests/turnstile-launcher.node.mjs tests/oauth-oidc-launcher.node.mjs tests/oauth-oidc-lifecycle.node.mjs tests/oauth-oidc-browser-owner.node.mjs && pnpm test:browser-probes && pnpm -r --if-present test",
    "test:browser-probes": "node --test tests/browser-probes/*_test.mjs",
    "phase1:launch": "node scripts/phase1-local-launcher.mjs",
    "layout": "node scripts/assert-layout.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "dev:desktop": "pnpm --filter @pigclaude/desktop dev",
    "e2e:oauth-oidc": "node scripts/oauth-oidc-e2e.mjs",
    "oauth-oidc:launch": "node scripts/oauth-oidc-local-launcher.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
